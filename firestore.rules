rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Pillar 3: Hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    // Pillar 1: Master Gate helper for user subcollections
    function ownsParentAccount(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.ownerId == request.auth.uid;
    }

    // Pillar 2 & 5: UserAccount validation blueprint
    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['ownerId', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['ownerId', 'displayName', 'createdAt', 'updatedAt']) &&
        data.ownerId is string &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        data.displayName is string &&
        data.displayName.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProfileMap(profile) {
      return profile is map &&
        profile.keys().hasAll(['displayName', 'createdAt']) &&
        profile.keys().hasOnly(['displayName', 'createdAt']) &&
        profile.displayName is string &&
        profile.displayName.size() <= 100 &&
        profile.createdAt is string &&
        profile.createdAt.size() <= 64;
    }

    function isValidSettingsMap(settings) {
      return settings is map &&
        settings.keys().hasAll(['theme', 'sound', 'haptics', 'motion']) &&
        settings.keys().hasOnly(['theme', 'sound', 'haptics', 'motion']) &&
        settings.theme in ['light', 'dark', 'system'] &&
        settings.sound is bool &&
        settings.haptics is bool &&
        settings.motion in ['system', 'reduced', 'full'];
    }

    function isValidRepEvents(repEvents) {
      return repEvents is list &&
        repEvents.size() <= 5000 &&
        (repEvents.size() == 0 || (
          repEvents[0] is map &&
          repEvents[0].keys().hasAll(['id', 'counter', 'at', 'day']) &&
          repEvents[0].keys().hasOnly(['id', 'counter', 'at', 'day']) &&
          repEvents[0].id is string &&
          repEvents[0].id.size() >= 1 &&
          repEvents[0].id.size() <= 128 &&
          repEvents[0].counter in ['approaches', 'conversations', 'kindnesses', 'courageReps'] &&
          repEvents[0].at is string &&
          repEvents[0].at.size() <= 64 &&
          (repEvents[0].day == null || (repEvents[0].day is int && repEvents[0].day >= 1 && repEvents[0].day <= 30))
        ));
    }

    function isValidXpEvents(xpEvents) {
      return xpEvents is list &&
        xpEvents.size() <= 5000 &&
        (xpEvents.size() == 0 || (
          xpEvents[0] is map &&
          xpEvents[0].keys().hasAll(['id', 'at', 'amount', 'source', 'day']) &&
          xpEvents[0].keys().hasOnly(['id', 'at', 'amount', 'source', 'day', 'refId']) &&
          xpEvents[0].id is string &&
          xpEvents[0].id.size() >= 1 &&
          xpEvents[0].id.size() <= 128 &&
          xpEvents[0].at is string &&
          xpEvents[0].at.size() <= 64 &&
          xpEvents[0].amount is number &&
          xpEvents[0].source in ['briefing', 'quiz', 'scenario', 'mission', 'hardcore', 'rep', 'logEntry', 'streakBonus', 'chapterChest'] &&
          (xpEvents[0].day == null || (xpEvents[0].day is int && xpEvents[0].day >= 1 && xpEvents[0].day <= 30)) &&
          (!('refId' in xpEvents[0]) || (xpEvents[0].refId is string && xpEvents[0].refId.size() <= 128))
        ));
    }

    function isValidOpenedChests(openedChests) {
      return openedChests is list &&
        openedChests.size() <= 4 &&
        (openedChests.size() == 0 || (openedChests[0] is int && openedChests[0] >= 1 && openedChests[0] <= 4));
    }

    // Pillar 2 & 5: ChallengeProgress validation blueprint
    function isValidChallengeProgress(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'schemaVersion', 'profile', 'settings', 'days', 'logEntries',
          'repEvents', 'xpEvents', 'openedChests', 'unlockedBadges',
          'lastDeviceId', 'clientUpdatedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'ownerId', 'schemaVersion', 'profile', 'settings', 'days', 'logEntries',
          'repEvents', 'xpEvents', 'openedChests', 'unlockedBadges',
          'lastDeviceId', 'clientUpdatedAt', 'createdAt', 'updatedAt'
        ]) &&
        data.ownerId is string &&
        isValidId(data.ownerId) &&
        data.ownerId == request.auth.uid &&
        data.ownerId == userId &&
        data.schemaVersion is int &&
        data.schemaVersion == 1 &&
        isValidProfileMap(data.profile) &&
        isValidSettingsMap(data.settings) &&
        data.days is map &&
        data.days.size() <= 30 &&
        data.logEntries is map &&
        data.logEntries.size() <= 30 &&
        isValidRepEvents(data.repEvents) &&
        isValidXpEvents(data.xpEvents) &&
        isValidOpenedChests(data.openedChests) &&
        data.unlockedBadges is map &&
        data.unlockedBadges.size() <= 100 &&
        data.lastDeviceId is string &&
        isValidId(data.lastDeviceId) &&
        data.lastDeviceId.size() <= 64 &&
        data.clientUpdatedAt is string &&
        data.clientUpdatedAt.size() >= 1 &&
        data.clientUpdatedAt.size() <= 64 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId) && (resource == null || existing().ownerId == request.auth.uid);
      allow list: if false;
      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        resource != null &&
        isValidUserAccount(incoming(), userId) &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if isValidId(userId) && isOwner(userId) && resource != null && existing().ownerId == request.auth.uid;

      match /sync/{syncId} {
        allow get: if isValidId(userId) &&
          isValidId(syncId) &&
          syncId == 'challenge_v1' &&
          isOwner(userId) &&
          (resource == null || existing().ownerId == request.auth.uid) &&
          ownsParentAccount(userId);
        allow list: if false;
        allow create: if isValidId(userId) &&
          isValidId(syncId) &&
          syncId == 'challenge_v1' &&
          isOwner(userId) &&
          isValidChallengeProgress(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          ownsParentAccount(userId);
        allow update: if isValidId(userId) &&
          isValidId(syncId) &&
          syncId == 'challenge_v1' &&
          isOwner(userId) &&
          resource != null &&
          isValidChallengeProgress(incoming(), userId) &&
          incoming().ownerId == existing().ownerId &&
          incoming().schemaVersion == existing().schemaVersion &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          ownsParentAccount(userId) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'profile',
            'settings',
            'days',
            'logEntries',
            'repEvents',
            'xpEvents',
            'openedChests',
            'unlockedBadges',
            'lastDeviceId',
            'clientUpdatedAt',
            'updatedAt'
          ]);
        allow delete: if isValidId(userId) &&
          isValidId(syncId) &&
          syncId == 'challenge_v1' &&
          isOwner(userId) &&
          resource != null &&
          existing().ownerId == request.auth.uid &&
          ownsParentAccount(userId);
      }
    }
  }
}
